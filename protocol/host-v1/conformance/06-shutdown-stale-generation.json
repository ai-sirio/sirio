{
  "name": "shutdown-stale-generation",
  "major": 1,
  "steps": [
    {
      "send": { "id": 1, "method": "host.hello", "params": { "client_version": "conformance", "majors": [1], "minor": 0 } },
      "expect": { "id": 1, "result": { "type": "welcome" } }
    },
    {
      "send": { "id": 2, "method": "host.shutdown", "params": { "force": false }, "generation": "not-this-one" },
      "expect": { "id": 2, "error": { "code": "stale_generation" } }
    }
  ]
}
