{
  "name": "create-in-missing-cwd",
  "major": 1,
  "steps": [
    {
      "send": { "id": 1, "method": "host.hello", "params": { "client_version": "conformance", "majors": [1], "minor": 1 } },
      "expect": { "id": 1, "result": { "type": "welcome" } }
    },
    {
      "send": { "id": 2, "method": "term.create", "params": { "session_id": "pane-12", "cwd": "/__sirio_host_conformance_missing_cwd__", "command": { "type": "shell" }, "size": { "cols": 80, "rows": 24 }, "origin": "control" }, "generation": "$generation" },
      "expect": { "id": 2, "error": { "code": "invalid_cwd" } }
    }
  ]
}
