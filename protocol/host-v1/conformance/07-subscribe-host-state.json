{
  "name": "subscribe-host-state",
  "major": 1,
  "steps": [
    {
      "send": { "id": 1, "method": "host.hello", "params": { "client_version": "conformance", "majors": [1], "minor": 0 } },
      "expect": { "id": 1, "result": { "type": "welcome" } }
    },
    {
      "send": { "id": 2, "method": "host.subscribe", "params": { "topic": "host.state" } },
      "expect": { "id": 2, "result": { "subscription": 1 } }
    }
  ]
}
