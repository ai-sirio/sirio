# The generated project is ignored, EXCEPT the SwiftPM lockfile. Without that file a
# fresh clone or worktree re-resolves the whole graph, and libghostty-spm
# `from: "1.2.0"` then selects 1.3.2 — whose tag was force-moved upstream — failing
# with "does not match previously recorded value".
# Git will not descend into an excluded directory, so each level must exclude its
# *contents* (`dir/*`) rather than the directory itself for the negations to apply.
Tiller.xcodeproj/*
!Tiller.xcodeproj/project.xcworkspace/
Tiller.xcodeproj/project.xcworkspace/*
!Tiller.xcodeproj/project.xcworkspace/xcshareddata/
Tiller.xcodeproj/project.xcworkspace/xcshareddata/*
!Tiller.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Tiller.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Tiller.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# ImageRenderer test fixtures (AppTests) — regenerated by `swift test`, not source.
artifacts/
DerivedData/
.build/
.swiftpm/
App/Info.plist
build/
.tokensave/
.superpowers/
.worktrees/
.serena/
.agents/
.opencode/
.pi/
.claude/
skills-lock.json
.DS_Store
opencode.json
/.air/
/.codex/
