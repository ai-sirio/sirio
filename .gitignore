# ImageRenderer test fixtures (AppTests) — regenerated by `swift test`, not source.
artifacts/
.swiftpm/
App/Info.plist
build/
.tokensave/
.superpowers/
.worktrees/
.serena/
.agents/
.opencode/
.pi/
.claude/
# Generated per-worktree agent hook, written by OhMyPiAdapter::prepare on every
# omp launch and carrying that machine's sirioctl path and that launch's pane id
# (#203). Its five siblings above are ignored for the same reason.
.sirio/
.idea/
skills-lock.json
.DS_Store
opencode.json
/.air/
/.codex/

# Python bytecode from the Linux verification scripts
__pycache__/
*.pyc

# Local tool/IDE/planning artifacts — not shared repo content. docs/ stays
# local except the release notes: release.yml refuses a tag whose
# docs/release-notes/<version>.md is missing, so that one directory is repo
# content (a parent excluded with `/docs/` could not be re-included).
/.codegraph/
/docs/*
!/docs/release-notes/
/output/
/plans/
