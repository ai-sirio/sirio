#!/usr/bin/env bash
# Stand-in for the `pi` CLI in the hook E2E. Pi has no hooks, so Sirio can only
# identify it from its terminal title, and no lifecycle event ever reaches
# `sirioctl`. This stub writes its pane id, sets the title Pi sets (`π - <cwd>`)
# with an OSC 0 sequence, and holds the pane: its status is what the title says,
# and an idle π title reads as needs-input.
#
# Handshake, through $HOOK_STUB_OUT:
#   pi.pane  the pane id, written first and atomically;
#   pi.go    one file, taken by the stub's last step: an exit would be read as
#            the agent finishing, so the pane stays up until this arrives;
#   pi.log   `pi title printed; no hooks`.
set -euo pipefail

out=${HOOK_STUB_OUT:?HOOK_STUB_OUT must name the handshake directory}
: "${SIRIO_PANE_ID:?pi must run inside a Sirio pane}"
go="$out/pi.go"
log="$out/pi.log"

printf '%s\n' "$SIRIO_PANE_ID" > "$out/pi.pane.tmp"
mv -f "$out/pi.pane.tmp" "$out/pi.pane"

printf '\033]0;π - %s\007' "$PWD"
echo "pi title printed; no hooks" >> "$log"

until [ -e "$go" ]; do sleep 0.2; done
rm -f "$go"
