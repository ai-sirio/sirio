#!/usr/bin/env bash
# Stand-in for the `opencode` CLI in the hook E2E. OpenCode's worktree plugin,
# `.opencode/plugin/sirio-session.js`, reports the session id with
# `sirioctl session-ref` when OpenCode updates a session. It sends no status, so
# the pane's status does not change when this fires. This stub runs that plugin
# with node against one `session.updated` event: a minimal driver calls the
# plugin's factory with a `$` shell, then sends the event to its handler.
#
# Handshake, through $HOOK_STUB_OUT:
#   opencode.pane  the pane id, written first and atomically;
#   opencode.go    the one step: it waits for this file, takes it, then fires;
#   opencode.log   `opencode session.updated exit=<status>`, or a SKIP.
# The pane stays up after the event until one more opencode.go. Without node the
# stub records a SKIP and holds the pane the same way.
set -euo pipefail

out=${HOOK_STUB_OUT:?HOOK_STUB_OUT must name the handshake directory}
: "${SIRIO_PANE_ID:?opencode must run inside a Sirio pane}"
go="$out/opencode.go"
log="$out/opencode.log"

printf '%s\n' "$SIRIO_PANE_ID" > "$out/opencode.pane.tmp"
mv -f "$out/opencode.pane.tmp" "$out/opencode.pane"

# Waits for the E2E's go before the named hook, then takes it. A step the E2E never
# releases logs why and fails the stub rather than holding the pane forever.
await_go() {
  local hook=$1
  local deadline=$((SECONDS + 30))
  until [ -e "$go" ]; do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "timeout waiting for opencode.go before $hook" >> "$log"
      echo "opencode: timed out waiting for $go" >&2
      exit 1
    fi
    sleep 0.2
  done
  rm -f "$go"
}

hold() {
  until [ -e "$go" ]; do sleep 0.2; done
  rm -f "$go"
}

if ! command -v node >/dev/null 2>&1; then
  echo "SKIP: node is not on PATH" >> "$log"
  hold
  exit 0
fi

# The OpenCode plugin API, reduced to what the plugin uses: `$` runs a command
# with its words split as the template splits them, and `.quiet().nothrow()`
# resolves to the command's result.
driver="$out/opencode-driver.mjs"
cat > "$driver" <<'JS'
import { spawnSync } from 'node:child_process';

const [plugin, eventType] = process.argv.slice(2);
let status = 0;

const $ = (strings, ...values) => {
  const words = [];
  let word = null;
  strings.forEach((text, index) => {
    for (const piece of text.split(/(\s+)/)) {
      if (piece === '') continue;
      if (/^\s+$/.test(piece)) {
        if (word !== null) {
          words.push(word);
          word = null;
        }
      } else {
        word = (word ?? '') + piece;
      }
    }
    if (index < values.length) word = (word ?? '') + String(values[index]);
  });
  if (word !== null) words.push(word);
  const shell = {
    quiet: () => shell,
    nothrow: async () => {
      const result = spawnSync(words[0], words.slice(1), { stdio: 'ignore' });
      status = result.status ?? 1;
      return result;
    },
  };
  return shell;
};

const { SirioSession } = await import(plugin);
const hooks = await SirioSession({ $ });
await hooks.event({
  event: { type: eventType, properties: { info: { id: 'stub-opencode' } } },
});
process.exitCode = status;
JS

# The plugin is copied under an .mjs name, which gives Node the module type
# without its syntax detection. The copy is byte-identical to the worktree's
# plugin, which stays the source.
plugin_source="$PWD/.opencode/plugin/sirio-session.js"
if [ ! -f "$plugin_source" ]; then
  echo "no $plugin_source to run" >> "$log"
  exit 1
fi
plugin="$(cd "$out" && pwd)/opencode-plugin.mjs"
cp "$plugin_source" "$plugin"
if ! cmp -s "$plugin_source" "$plugin"; then
  echo "the copy of $plugin_source differs from it" >> "$log"
  exit 1
fi

await_go "session.updated"
status=0
node "$driver" "$plugin" session.updated || status=$?
echo "opencode session.updated exit=$status" >> "$log"

hold
