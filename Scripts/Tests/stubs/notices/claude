#!/bin/sh
# The `claude` of test-chat-session-panel-e2e.sh's notice_* scenarios: the version probe answers at once
# (above sirio_claude::MIN_CLAUDE_VERSION, so the chat is native), and any other call is the stream-json
# fixture in its cli_notices mode (the prompt picks the turn: retry twice, retry kinds, retry out, notify,
# notify short, notify short again, notify typed, refuse, refuse fallback, refuse none, inform levels,
# subagent text, midstream, midstream drop, unstreamed; anything else answers ok). Every SIRIO_FIXTURE_*
# variable below that the scenario sets is handed to the fixture as its matching flag; an unset one passes nothing:
#   SIRIO_FIXTURE_RETRY_GATE  --fixture-retry-gate  holds `retry twice` after its retries until the file exists
#   SIRIO_FIXTURE_STARTUP     --fixture-startup     the kind of start-up failure the CLI reports (A7 Task 5)
# Every call is recorded in $SIRIO_STUB_LOG when the run names one.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
[ -z "${SIRIO_STUB_LOG:-}" ] || printf 'claude %s\n' "$*" >>"$SIRIO_STUB_LOG"
case "$1" in
  --version|-V|version)
    echo "9.9.9 (Claude Code)"
    exit 0 ;;
esac
exec python3 "$here/../../../../rust/crates/sirio_chat/tests/fixtures/claude_fixture.py" cli_notices \
  ${SIRIO_FIXTURE_RETRY_GATE:+"--fixture-retry-gate=$SIRIO_FIXTURE_RETRY_GATE"} \
  ${SIRIO_FIXTURE_STARTUP:+"--fixture-startup=$SIRIO_FIXTURE_STARTUP"} \
  "$@"
