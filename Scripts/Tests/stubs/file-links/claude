#!/bin/sh
# The `claude` of the file_links scenario of test-chat-session-panel-e2e.sh: the version
# probe answers at once (above sirio_claude::MIN_CLAUDE_VERSION, so the chat is
# native), and any other call is the stream-json fixture in its file_links mode, which
# answers every prompt with one text that holds the paths and links the scenario clicks.
# Every call is recorded in $SIRIO_STUB_LOG when the run names one.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
[ -z "${SIRIO_STUB_LOG:-}" ] || printf 'claude %s\n' "$*" >>"$SIRIO_STUB_LOG"
case "$1" in
  --version|-V|version)
    echo "9.9.9 (Claude Code)"
    exit 0 ;;
esac
exec python3 "$here/../../../../rust/crates/sirio_acp/tests/fixtures/claude_fixture.py" file_links "$@"
