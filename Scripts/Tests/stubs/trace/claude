#!/bin/sh
# The `claude` of the trace scenarios of test-chat-session-panel-e2e.sh: the version
# probe answers at once (above sirio_claude::MIN_CLAUDE_VERSION, so the chat is
# native), and any other call is the stream-json fixture in its trace mode, whose
# scripted turns the first word of a prompt picks and TRACE_STEP_MS paces. Every
# call is recorded in $SIRIO_STUB_LOG when the run names one.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
[ -z "${SIRIO_STUB_LOG:-}" ] || printf 'claude %s\n' "$*" >>"$SIRIO_STUB_LOG"
case "$1" in
  --version|-V|version)
    echo "9.9.9 (Claude Code)"
    exit 0 ;;
esac
exec python3 "$here/../../../../rust/crates/sirio_acp/tests/fixtures/claude_fixture.py" trace "$@"
