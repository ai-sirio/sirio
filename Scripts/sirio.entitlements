<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one exception the hardened runtime needs. Without it macOS refuses
	     every Apple Event from Sirio and from the tools in its panes, with no
	     prompt: see Scripts/build-app-bundle.sh. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
